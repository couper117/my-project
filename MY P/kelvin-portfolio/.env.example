# Copy this file to .env and change the values

# First-run admin account (created only if no admin exists yet)
ADMIN_USER=kelvin
ADMIN_PASSWORD=change-me-now

# Secret used to sign login tokens — set a long random string in production
JWT_SECRET=

# Port the server listens on
PORT=4000

# Set to "production" when deployed behind HTTPS
NODE_ENV=development
